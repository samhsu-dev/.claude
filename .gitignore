# Ignore everything by default
*

# Track CLAUDE.md, rules, and skills
!CLAUDE.md
!README.md
!rules/
!rules/**
!skills/
!skills/**

# Track .gitignore itself
!.gitignore
!LICENSE

# App-managed skills are local runtime data
/skills/synced/

# Generated dependencies, caches, and local secrets (including inside skills)
node_modules/
__pycache__/
*.py[cod]
.venv/
.env
.env.*
!.env.example
!.env.sample

# macOS noise
.DS_Store
**/.DS_Store
